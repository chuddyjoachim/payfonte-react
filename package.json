{
  "name": "@payfonte/payfonte-react",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/chuddyjoachim/payfonte-react.git"
  },
  "description": "This is an reactJS library for implementing payfonte payment checkout",
  "main": "dist/index.js",
  "module": "dist/index.modern.js",
  "source": "src/index.ts",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "microbundle-crl --no-compress --format modern,cjs",
    "dev": "microbundle-crl watch --no-compress --format modern,cjs",
    "lint": "tsc && eslint -c ./.eslintrc.json . --ext ts,tsx ./src/ && prettier --check src/**/*.ts",
    "lint:fix": "eslint --fix . && prettier --write .",
    "nuke": "rm -rf dist node_modules",
    "ci": "npm run lint && npm run build",
    "release": "npm run lint && npm run build && changeset publish",
    "changeset": "npx changeset"
  },
  "keywords": [
    "Javascript",
    "Typescript",
    "payment",
    "checkout",
    "payfusion",
    "payfonte",
    "payment orchestrator",
    "payfonte-react"
  ],
  "author": "Chikezie Joachim",
  "license": "MIT",
  "peerDependencies": {
    "react": "^15.0.0 || ^16.0.0 || ^17.0.0 || ^18.0.0",
    "react-dom": "^15.0.0 || ^16.0.0 || ^17.0.0 || ^18.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^20.8.6",
    "@types/react": "^18.2.28",
    "@types/react-dom": "^18.2.13",
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.33.2",
    "microbundle-crl": "^0.13.11",
    "prettier": "^3.0.3",
    "react": "^18.2.0",
    "typescript": "^5.2.2"
  },
  "overrides": {
    "@babel/helpers": "^7.26.10",
    "@babel/runtime": "^7.26.10",
    "@babel/plugin-transform-modules-systemjs": "^7.29.4",
    "ajv": "^6.14.0",
    "brace-expansion": "^1.1.13",
    "braces": "^3.0.3",
    "cross-spawn": "^7.0.6",
    "flatted": "^3.4.2",
    "js-yaml": "^4.1.1",
    "micromatch": "^4.0.8",
    "minimatch": "^3.1.4",
    "nth-check": "^2.1.1",
    "picomatch": "^2.3.2",
    "postcss": "^8.5.15",
    "serialize-javascript": "^7.0.3",
    "svgo": "^4.0.1",
    "tmp": "^0.2.5",
    "yaml": "^2.8.1"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
